APP_NAME="Finance Automation System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_TIMEZONE=America/Port_of_Spain

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# SQL Server — shared settings for SWRHAExpenseControl and FinanceAutomationSystem
# SQLSRV_HOST=
# SQLSRV_PORT=1433
# SQLSRV_USERNAME=
# SQLSRV_PASSWORD=
# SQLSRV_ENCRYPT=yes
# SQLSRV_TRUST_SERVER_CERT=true
# Self-service password change on /profile. Writes four columns of
# SWRHAExpenseControl.dbo.0006AWebAppControls, which needs the column-level
# GRANT in sql/GrantPasswordUpdate.sql. Leave false until that is applied —
# it is also the rollback that needs no redeploy.
DIRECTORY_PASSWORD_CHANGE=false

# How long active.user may trust the local users.is_active mirror before
# re-reading the directory, and how soon it retries after a failed read.
# Bounded PER USER (the stamp lives on the users row), so the cost is at most
# one directory lookup per active user per window - not per request.
# Normalised by App\Support\ActiveCheckWindow: 0 does NOT mean 'check every
# request' and there is no way to switch the check off. Clamped to 15..900.
ACTIVE_USER_TTL_SECONDS=60
ACTIVE_USER_OUTAGE_RETRY_SECONDS=15


# SQL Server — FinanceAutomationSystem credentials (falls back to SQLSRV_USERNAME/PASSWORD if unset)
# FAS_SQLSRV_USERNAME=
# FAS_SQLSRV_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Minutes that budget-allocation filter dropdowns are cached (file store)
BUDGET_ALLOCATION_CACHE_MINUTES=10

# ── Finance data settings (config/budget.php, config/expenditure.php,
#    config/ledger.php). All optional — the defaults shown are the ones the
#    config files carry. Documented here because none of them was discoverable
#    before: an operator reading .env.example alone could not tell these knobs
#    existed. ────────────────────────────────────────────────────────────────

# Minutes that monthly-expenditure filter dropdowns are cached (file store)
MONTHLY_EXPENDITURE_CACHE_MINUTES=10

# Minutes that the ledger-backed pages' filter dropdowns are cached, and how
# long the snapshot RefreshedAt probe that VERSIONS those keys is itself cached.
FINANCE_LEDGER_CACHE_MINUTES=10
FINANCE_LEDGER_VERSION_SECONDS=60

# `php artisan ledger:refresh` with no --year rebuilds this many recent fiscal
# years. MANUAL RUNS ONLY — the schedule is the SQL Agent job, whose own
# arithmetic must be changed to match if this changes.
FINANCE_LEDGER_REFRESH_RECENT_YEARS=2
# Retained but UNUSED (the Laravel schedule it belonged to is gone).
FINANCE_LEDGER_REFRESH_TIMEOUT=7200

# The requisition snapshot (Phase 2). Its cache is versioned against
# dbo.FinanceRequisitionRefresh, NOT the ledger's log — the two snapshots are
# built by two STEPS of one Agent job and can legitimately diverge.
FINANCE_REQUISITION_CACHE_MINUTES=10
FINANCE_REQUISITION_VERSION_SECONDS=60
# How far apart the two snapshots' RefreshedAt may be before `ledger:status`
# calls them run-drifted. Must exceed the ledger step's own duration.
FINANCE_REQUISITION_MAX_DRIFT_MINUTES=180
# The age at which the snapshot is called STALE, in hours. ONE definition,
# shared by `ledger:status` (as its --max-age-hours default) and by the two
# detail pages, which surface staleness in their context strip — two
# definitions would drift, and the page would reassure a user the health check
# was already alerting on. 36h because the Agent job runs daily at 21:30, so
# anything past that means a nightly run was missed. 0 disables the age check
# on the page (a FAILED run is still reported — that is an outcome, not an age).
FINANCE_REQUISITION_MAX_AGE_HOURS=36

# Bounded-fetch guard on the two requisition detail pages, where fiscal year is
# an OPTIONAL filter and the default scope is every eligible year
# (routingupdate.md §6). The fetch is LIMIT row_ceiling + 1, so getting
# ceiling + 1 rows back is the too-large signal and the page refuses rather
# than truncating.
#
#   row_ceiling  0 DISABLES the guard entirely (refusal AND warnings) and is
#                not for production. Anything unparseable falls back to the
#                default of 25000 — never to "no limit". Hard maximum 50000,
#                which is a PARSER bound, not a certified-safe value.
#   row_warn     logs a warning below the ceiling; 0 disables warnings alone,
#                and a value >= row_ceiling is clamped to 80% of it.
#
# Changing either needs a config reload (config:clear / config:cache plus a
# worker recycle), not just an .env edit.
FINANCE_REQUISITION_ROW_CEILING=25000
FINANCE_REQUISITION_ROW_WARN=20000

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_APP_TAGLINE="All SWRHA Digital Services"

DEBUGBAR_ENABLED=false

